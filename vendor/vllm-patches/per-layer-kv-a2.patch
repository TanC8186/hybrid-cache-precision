+def test_packed_mamba_cache_uses_strided_view():
+    page_size = 8
+    block_stride = 24
+    num_blocks = 3
+    raw_tensor = torch.zeros(num_blocks * block_stride, dtype=torch.int8)
+    mamba_spec = MambaSpec(
+        block_size=16,
+        shapes=((page_size,),),
+        dtypes=(torch.int8,),
+    )
+    kv_cache_config = KVCacheConfig(
+        num_blocks=num_blocks,
+        kv_cache_tensors=[
+            KVCacheTensor(
+                size=raw_tensor.numel(),
+                shared_by=["mamba.0"],
+                offset=12,
+                block_stride=block_stride,
+            )
+        ],
+        kv_cache_groups=[
+            KVCacheGroupSpec(["mamba.0"], mamba_spec),
+        ],
+    )
+
+    group = SimpleNamespace(
+        kv_cache_spec=mamba_spec,
+        backend=None,
+        kv_cache_group_id=0,
+        layer_names=["mamba.0"],
+    )
+    runner = SimpleNamespace(
+        kv_cache_config=kv_cache_config,
+        runner_only_attn_layers=set(),
+        attn_groups=[[group]],
+        _kv_cache_spec_attn_group_iterator=lambda: iter([group]),
+        _has_mixed_attention_kv_layout=lambda _: False,
+        _update_hybrid_attention_mamba_layout=Mock(),
+    )
+
+    caches = GPUModelRunner._reshape_kv_cache_tensors(
+        runner,
+        {"mamba.0": raw_tensor},
+        [16],
+    )
+    cache = caches["mamba.0"]
+
+    assert cache.shape == (num_blocks, 1, 1, page_size)
+    assert cache.stride()[0] == block_stride
+    cache[1].fill_(7)
+    assert (raw_tensor[block_stride + 12 : block_stride + 20] == 7).all()
+    assert (raw_tensor[:12] == 0).all()
+
+
