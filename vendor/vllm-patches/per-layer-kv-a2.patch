+def test_per_layer_page_groups_preserve_mixed_attention_pages_with_mamba():
+    vllm_config = SimpleNamespace(
+        cache_config=SimpleNamespace(
+            enable_per_layer_page_groups=True,
+            num_gpu_blocks_override=None,
+            mamba_cache_mode="none",
+        ),
+        scheduler_config=SimpleNamespace(
+            disable_hybrid_kv_cache_manager=False,
+        ),
+        model_config=SimpleNamespace(max_model_len=4096),
+        parallel_config=SimpleNamespace(decode_context_parallel_size=1),
+        speculative_config=None,
+        kv_transfer_config=None,
+    )
+
+    int4_spec = new_kv_cache_spec(
+        block_size=16,
+        dtype=torch.uint8,
+        kv_quant_mode=KVQuantMode.INT4_PER_TOKEN_HEAD,
+    )
+    bf16_spec = new_kv_cache_spec(
+        block_size=16,
+        dtype=torch.bfloat16,
+    )
+    mamba_spec = new_mamba_spec(
+        block_size=16,
+        shapes=((2, 64), (4, 64)),
+        dtypes=(torch.bfloat16, torch.float32),
+    )
+    specs = {
+        "attn.int4.0": int4_spec,
+        "attn.int4.1": int4_spec,
+        "attn.bf16": bf16_spec,
+        "mamba.0": mamba_spec,
+        "mamba.1": mamba_spec,
+    }
+
+    groups = get_kv_cache_groups(vllm_config, specs)
+
+    assert len(groups) == 2
+    attention_group = groups[0]
+    assert isinstance(attention_group.kv_cache_spec, UniformTypeKVCacheSpecs)
+    assert attention_group.kv_cache_spec.kv_cache_specs == {
+        "attn.int4.0": int4_spec,
+        "attn.int4.1": int4_spec,
+        "attn.bf16": bf16_spec,
+    }
+    assert {
+        spec.block_size
+        for spec in attention_group.kv_cache_spec.kv_cache_specs.values()
+    } == {16}
+    assert len(
+        {
+            spec.page_size_bytes
+            for spec in attention_group.kv_cache_spec.kv_cache_specs.values()
+        }
+    ) == 2
+    assert isinstance(groups[1].kv_cache_spec, MambaSpec)
+    assert groups[1].layer_names == ["mamba.0", "mamba.1"]
+
+    from vllm.v1.core.kv_cache_utils import (
+        _get_kv_cache_config_packed,
+        _get_packed_kv_cache_layout,
+        _max_memory_usage_bytes_from_groups,
+        _use_packed_kv_cache_config,
+    )
+
+    assert _use_packed_kv_cache_config(vllm_config, groups)
+    block_stride, _ = _get_packed_kv_cache_layout(groups)
+    num_blocks, tensors = _get_kv_cache_config_packed(
+        vllm_config,
+        groups,
+        available_memory=block_stride * 32,
+    )
+    assert num_blocks == 32
+    assert {tensor.block_stride for tensor in tensors} == {block_stride}
+    assert {tensor.size for tensor in tensors} == {block_stride * 32}
+
+    blocks_needed = sum(
+        (
+            group.kv_cache_spec.max_memory_usage_bytes(vllm_config)
+            + group.kv_cache_spec.page_size_bytes
+            - 1
+        )
+        // group.kv_cache_spec.page_size_bytes
+        for group in groups
+    )
+    assert _max_memory_usage_bytes_from_groups(
+        vllm_config,
+        groups,
+    ) == block_stride * blocks_needed
+
+
