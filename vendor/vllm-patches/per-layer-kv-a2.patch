+    kv_cache_dtype_per_layer: dict[str, CacheDType] = field(default_factory=dict)
+    """Per-layer KV cache dtype override (our sensitivity-guided allocation).
+    Keys are layer indices as strings (e.g., '23'), values are CacheDType
