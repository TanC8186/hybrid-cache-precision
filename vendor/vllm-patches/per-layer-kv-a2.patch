@@ -301,3 +322,20 @@ class CacheConfig:
                 str(cache_dtype),
             )
         return cache_dtype
+
+    @field_validator("kv_cache_dtype_per_layer", mode="after")
+    @classmethod
+    def _validate_per_layer_cache_dtypes(
+        cls,
+        per_layer_dtypes: dict[str, CacheDType],
+    ) -> dict[str, CacheDType]:
+        for layer_idx, cache_dtype in per_layer_dtypes.items():
+            if not layer_idx.isdigit():
+                raise ValueError(
+                    "Per-layer KV cache dtype keys must be non-negative layer indices"
+                )
+            if cache_dtype in _UNIMPLEMENTED_CACHE_DTYPES:
+                raise ValueError(
+                    f"KV cache dtype {cache_dtype!r} has no runtime kernel implementation"
+                )
+        return per_layer_dtypes
