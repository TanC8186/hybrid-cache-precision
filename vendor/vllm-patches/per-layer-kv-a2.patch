+
+@pytest.mark.parametrize("cache_dtype", ["int2_per_token_head", "int3_per_token_head"])
+def test_cache_config_rejects_unimplemented_cache_dtype(cache_dtype):
+    with pytest.raises(ValueError, match="no runtime kernel implementation"):
