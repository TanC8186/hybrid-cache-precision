# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
!/scripts/env/

# --- 实验原始运行产物（按设计 gitignored；provenance 见 results/_provenance.jsonl）---
experiments/*
!experiments/README.md
*.log
*.tar.gz

# --- 模型权重 / 校准产物 / checkpoint（大二进制）---
