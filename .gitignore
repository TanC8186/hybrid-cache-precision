*.pt
*.pth
*.ckpt
*.bin
*.onnx

# --- 数据（大文件；溯源见 data/MANIFEST.yaml，保留 MANIFEST 与 README）---
/data/*
!/data/MANIFEST.yaml
!/data/README.md

# --- OS / 编辑器 ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

